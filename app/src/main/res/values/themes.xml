<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the app's colours itself (ui/theme). This only sets the window
         behind it, and stops the phone's own "force dark" from re-colouring the app. -->
    <style name="Theme.Satchel" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/satchel_background</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
