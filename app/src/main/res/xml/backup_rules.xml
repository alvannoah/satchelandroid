<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. The login token is encrypted with a key that never
     leaves the device, so a restored copy could not be read: leave it out. -->
<full-backup-content>
    <exclude domain="sharedpref" path="satchel.secure.xml" />
    <!-- Downloaded documents can be downloaded again; they would overflow the backup. -->
    <exclude domain="file" path="downloads/" />
</full-backup-content>
