<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: never back up or transfer the encrypted login token. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="satchel.secure.xml" />
        <exclude domain="file" path="downloads/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="satchel.secure.xml" />
    </device-transfer>
</data-extraction-rules>
