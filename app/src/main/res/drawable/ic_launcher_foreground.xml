<?xml version="1.0" encoding="utf-8"?>
<!--
    A satchel: handle, flap with a clasp, and body, in white. The pieces are separate
    shapes with real gaps between them (and the clasp is cut out of the flap), so the
    same drawable also works as the monochrome layer for themed icons, which uses
    only its shape. Drawn on the adaptive icon's 108-unit grid, inside the safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.92"
        android:scaleY="0.92"
        android:translateY="2">
        <!-- handle -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M44,41 V36 a8,8 0 0 1 8,-8 h4 a8,8 0 0 1 8,8 v5 h-4.5 v-5 a3.5,3.5 0 0 0 -3.5,-3.5 h-4 a3.5,3.5 0 0 0 -3.5,3.5 v5 z" />
        <!-- flap, with the clasp cut out -->
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M30,47 a7,7 0 0 1 7,-7 h34 a7,7 0 0 1 7,7 v5 c0,0 -10,8 -24,8 c-14,0 -24,-8 -24,-8 z M50,49 h8 a2,2 0 0 1 2,2 v3 a2,2 0 0 1 -2,2 h-8 a2,2 0 0 1 -2,-2 v-3 a2,2 0 0 1 2,-2 z" />
        <!-- body -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M30,56.5 c0,0 10,8 24,8 c14,0 24,-8 24,-8 v14.5 a7,7 0 0 1 -7,7 h-34 a7,7 0 0 1 -7,-7 z" />
    </group>
</vector>
